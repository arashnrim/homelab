## Timezone
TZ=Asia/Singapore
## Transport: 0.0.0.0 is required so the published port can reach the server inside the container
MCP_TRANSPORT=http
MCP_BIND_HOST=0.0.0.0
## Komodo Core connection. Must be a valid URL: a blank value makes the container exit on startup.
KOMODO_URL=
## Komodo API key (create under a Komodo service account)
KOMODO_API_KEY=
KOMODO_API_SECRET=
